+/* Optional prerobot telemetry: 60-byte float payload, sensor acquisition uptime. */
+static float prerobot_telem[15];
+static sync_table_t *prerobot_tx;
+static uint32_t prerobot_seq;
+
+static void prerobot_sample(void)
+{
+	const struct device *const wheels[] = {
+		DEVICE_DT_GET(DT_NODELABEL(steerwheel1)),
+		DEVICE_DT_GET(DT_NODELABEL(steerwheel2)),
+		DEVICE_DT_GET(DT_NODELABEL(steerwheel3)),
+		DEVICE_DT_GET(DT_NODELABEL(steerwheel4)),
+	};
+	uint64_t us = k_ticks_to_us_floor64(k_uptime_ticks());
+	const chassis_data_t *data = chassis->data;
+	const chassis_cfg_t *cfg = chassis->config;
+	prerobot_telem[0] = (float)(prerobot_seq++ & 0xffffffU);
+	prerobot_telem[1] = (float)(us / 1000000U);
+	prerobot_telem[2] = (float)(us % 1000000U);
+	/* These are execution SETPOINTS in the driver's internal axes, not measured velocity. */
+	prerobot_telem[3] = data->set_status.speedX;
+	prerobot_telem[4] = data->set_status.speedY;
+	prerobot_telem[5] = data->set_status.gyro;
+	for (int i = 0; i < 4; ++i) {
+		wheel_status_t *s = wheel_get_speed(wheels[i]);
+		prerobot_telem[6 + i] = s ? s->speed : NAN;
+		prerobot_telem[10 + i] = s ? s->angle : NAN;
+	}
+	prerobot_telem[14] = cfg->max_lin_accel;
 }
 
